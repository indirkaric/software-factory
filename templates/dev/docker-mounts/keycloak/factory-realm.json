{
  "realm": "factory",
  "displayName": "Factory (local)",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 21600,
  "ssoSessionIdleTimeout": 86400,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Everything; trusted service-to-service callers get it too"
      },
      {
        "name": "MANAGER",
        "description": "Manage the domain data"
      },
      {
        "name": "READ-USER",
        "description": "Read users"
      },
      {
        "name": "EDIT-USER",
        "description": "Create and change users"
      },
      {
        "name": "READ-GROUP",
        "description": "Read permission groups"
      },
      {
        "name": "EDIT-GROUP",
        "description": "Create and change permission groups"
      },
      {
        "name": "READ-PERMISSION",
        "description": "Read the permission catalogue"
      },
      {
        "name": "READ-MY-PAT",
        "description": "Read own personal access tokens"
      },
      {
        "name": "EDIT-MY-PAT",
        "description": "Create and revoke own personal access tokens"
      },
      {
        "name": "READ-PAT",
        "description": "Read everyone's personal access tokens"
      },
      {
        "name": "READ-FILE",
        "description": "Download stored files"
      },
      {
        "name": "EDIT-FILE",
        "description": "Upload and delete stored files"
      }
    ]
  },
  "groups": [
    {
      "name": "Administrator",
      "path": "/Administrator",
      "realmRoles": [
        "ADMIN",
        "MANAGER",
        "READ-USER",
        "EDIT-USER",
        "READ-GROUP",
        "EDIT-GROUP",
        "READ-PERMISSION",
        "READ-MY-PAT",
        "EDIT-MY-PAT",
        "READ-PAT",
        "READ-FILE",
        "EDIT-FILE"
      ],
      "subGroups": []
    },
    {
      "name": "Manager",
      "path": "/Manager",
      "realmRoles": [
        "MANAGER",
        "READ-USER",
        "EDIT-USER",
        "READ-GROUP",
        "READ-PERMISSION",
        "READ-MY-PAT",
        "EDIT-MY-PAT",
        "READ-FILE",
        "EDIT-FILE"
      ],
      "subGroups": []
    },
    {
      "name": "Employee",
      "path": "/Employee",
      "realmRoles": [
        "READ-USER",
        "READ-PERMISSION",
        "READ-MY-PAT",
        "EDIT-MY-PAT",
        "READ-FILE"
