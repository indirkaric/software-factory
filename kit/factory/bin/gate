#!/usr/bin/env python3
# Adapted for Java/Spring Boot backends from zazencodes software-factory-claude-code-v2 (GPLv3).
"""The deterministic gate: does the job's branch pass the repo's checks?

Usage:
  gate <job-id>            write round-N/checks.md; exit 0 on PASS, 1 on FAIL
  gate <job-id> --merge    same, as round-N/merge-checks.md (job merge runs it)
  gate --hook              builder Stop hook: run the checks once, exit 2 on failure

When an earlier round's gate passed on the same commit with the same checks.sh and config.json,
the gate copies that checks.md (with a `REUSED FROM round-<N> (<sha>)` line) and passes at once.
When the builder's Stop hook already ran checks.sh on the same commit, with a
clean tree and the same checks.sh and config.json, the gate reuses that run
instead of building again (never for --merge, which runs after syncing with the
base branch).

The gate runs the main checkout's factory/checks.sh inside the job's worktree,
so a branch can't change the checks it is judged by. It also fails when the
branch modifies or deletes a file matching config.json `protected_paths`
(fnmatch patterns, where `*` also matches `/`). Adding new files is fine.
"""

import fnmatch
import hashlib
import json
import subprocess
import sys
import time
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
FACTORY = REPO / "factory"
CONFIG = json.loads((FACTORY / "config.json").read_text())
CHECKS = FACTORY / "checks.sh"
TAIL = 80


def die(msg):
    print(f"gate: {msg}", file=sys.stderr)
    sys.exit(2)


def git(worktree, *args):
    res = subprocess.run(["git", *args], cwd=worktree, capture_output=True, text=True)
    if res.returncode != 0:
        die(f"`git {' '.join(args)}` failed: {res.stderr.strip()}")
    return res.stdout


def protected_changes(worktree):
    """Existing files under protected_paths that the branch modified or deleted."""
    diff = git(worktree, "diff", "--name-status", f"origin/{CONFIG['base_branch']}...HEAD")
    hits = []
    for line in diff.splitlines():
        status, *paths = line.split("\t")
        if status.startswith("A"):
            continue
        old = paths[0]  # for renames and copies, the original path
        if any(fnmatch.fnmatch(old, pattern) for pattern in CONFIG["protected_paths"]):
            hits.append(f"{status[0]} {old}")
    return hits


def checks_sha():
    h = hashlib.sha1()
    for f in (CHECKS, FACTORY / "config.json"):
        h.update(f.read_bytes())
    return h.hexdigest()


def clean(worktree):
    return not git(worktree, "status", "--porcelain").strip()


HOOK_RUN = ".hook-checks.json"


def reused_run(round_dir, worktree, commit):
    """The builder hook's checks.sh result for exactly this state, or None."""
    try:
        run = json.loads((round_dir / HOOK_RUN).read_text())
    except (OSError, json.JSONDecodeError):
        return None
    if run.get("commit") == commit and run.get("checks") == checks_sha() and run.get("clean") and clean(worktree):
        return run
    return None


def earlier_pass(job_id, rnd, commit):
    """An earlier round's checks.md that passed on exactly this commit with the same checks:
    (round, its text) or None. A round over an unchanged commit doesn't pay for the gate again."""
    for n in range(rnd - 1, 0, -1):
        f = FACTORY / "jobs" / job_id / f"round-{n}" / "checks.md"
        if not f.exists():
            continue
        head = dict(l.split(": ", 1) for l in f.read_text().split("\n\n", 1)[0].splitlines() if ": " in l)
        if head.get("GATE") == "PASS" and head.get("COMMIT") == commit and head.get("CHECKS") == checks_sha():
            return n, f.read_text()
    return None


def run_checks(worktree):
    start = time.monotonic()
    res = subprocess.run(["bash", str(CHECKS)], cwd=worktree, capture_output=True, text=True)
    return res.returncode, res.stdout + res.stderr, int(time.monotonic() - start)


def gate(job_id, merge):
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text())
    worktree = job["worktree"]
    if job["round"] < 1:
        die(f"{job_id} hasn't started a build round")
    round_dir = FACTORY / "jobs" / job_id / f"round-{job['round']}"
    commit = git(worktree, "rev-parse", "HEAD").strip()
    earlier = None if merge or not clean(worktree) else earlier_pass(job_id, job["round"], commit)
    if earlier:
        n, text = earlier
        head, _, body = text.partition("\n\n")
        (round_dir / "checks.md").write_text(f"{head}\nREUSED FROM round-{n} ({commit[:7]})\n\n{body}")
        print(f"GATE: PASS ({job_id} round {job['round']}, REUSED FROM round-{n}: same commit {commit[:7]})")
        sys.exit(0)
    protected = protected_changes(worktree)
    reused = None if merge else reused_run(round_dir, worktree, commit)
    if reused:
        code, log, seconds = reused["code"], reused["log"], reused["seconds"]
    else:
        code, log, seconds = run_checks(worktree)
    verdict = "PASS" if code == 0 and not protected else "FAIL"
    name = "merge-checks" if merge else "checks"
    (round_dir / f"{name}.log").write_text(log)
    tail = "\n".join(log.rstrip().splitlines()[-TAIL:])
    summary = [
        f"checks.sh {'passed' if code == 0 else f'failed with exit {code}'} in {seconds}s"
        + (" (the builder's run on this exact commit, reused)" if reused else ""),
        f"Protected paths: {'changed: ' + ', '.join(protected) if protected else 'none changed'}",
        f"Commit {commit[:7]}" + (", synced with the latest main before merging" if merge else ""),
    ]
    (round_dir / f"{name}.md").write_text(
        f"GATE: {verdict}\nCOMMIT: {commit}\nCHECKS: {checks_sha()}\n\n"
        "## Summary\n" + "\n".join(f"- {s}" for s in summary) + "\n\n"
        "## Protected paths\n"
        + ("\n".join(f"- {p}" for p in protected) if protected else "None changed.")
        + f"\n\n## checks.sh\nExit {code} in {seconds}s. Last {TAIL} lines of {name}.log:\n\n```\n{tail}\n```\n"
    )
    print(f"GATE: {verdict} ({job_id} round {job['round']}, checks.sh exit {code} in {seconds}s"
          + (", reused the builder's run" if reused else "")
          + (f", protected paths changed: {', '.join(protected)}" if protected else "") + ")")
    sys.exit(0 if verdict == "PASS" else 1)


def hook():
    event = json.load(sys.stdin)
    if event.get("stop_hook_active"):
        sys.exit(0)  # one nudge per stop; the gate decides
    with open(Path(event["agent_transcript_path"]).expanduser()) as f:
        content = json.loads(f.readline())["message"]["content"]
    prompt = content if isinstance(content, str) else " ".join(b.get("text", "") for b in content)
    job_id = prompt.split("Job: ", 1)[1].split(".", 1)[0]
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text())
    worktree = job["worktree"]
    commit = git(worktree, "rev-parse", "HEAD").strip()
    code, log, seconds = run_checks(worktree)
    if job["round"] >= 1:
        # the gate reuses this when nothing changes before it runs
        (FACTORY / "jobs" / job_id / f"round-{job['round']}" / HOOK_RUN).write_text(json.dumps({
            "commit": commit, "clean": clean(worktree), "checks": checks_sha(),
            "code": code, "log": log, "seconds": seconds}))
    if code != 0:
        tail = "\n".join(log.rstrip().splitlines()[-40:])
        print(f"factory/checks.sh fails in your worktree (exit {code}). The gate will reject this "
              f"build. Fix it, or write STATUS: BLOCKED in build.md if you can't.\n\n{tail}",
              file=sys.stderr)
        sys.exit(2)


def main(argv):
    if argv == ["--hook"]:
        hook()
    elif len(argv) == 1 and not argv[0].startswith("-"):
        gate(argv[0], merge=False)
    elif len(argv) == 2 and argv[1] == "--merge":
        gate(argv[0], merge=True)
    else:
        die(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
