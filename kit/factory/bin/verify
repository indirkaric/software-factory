#!/usr/bin/env python3
"""Run a job's task locally against the development stack, for sf-verifier.

Usage:
  verify <job> up [--arg [<service>:]key=value ...]
                                          boot the whole task: every job's branch, wired to each
                                          other, plus the services that call them (from their base
                                          branch); prints APP lines, REPORT (the file to write)
  verify <job> smoke                      every running app's GET endpoints without parameters,
                                          as admin: anything 5xx is broken (regressions)
  verify <job> token [admin|manager|user|basic]   an access token from the local Keycloak
  verify <job> down                       stop every app of the task, drop their databases
  verify <job> publish                    after the merge: commit + push new permissions to the dev repo
  verify gc                               clean up apps of finished, dead or stale jobs (any session)
  verify ps                               what the factory runs right now, on which ports
  verify preflight [<job>]                can a local check run now (dev repo, docker, free infra
                                          ports; with a job: every service its task's specs REQUIRE
                                          runs an image with that commit)? PREFLIGHT: OK, or
                                          PREFLIGHT: BLOCKED <first reason>, `- ` reasons and
                                          `NEEDS:` lines (exit 3)

A task is a feature across services (factory/bin/job: task.json in the root job's folder);
a job without one is a task of one. `up` refuses until every job of the task is in verify.
Each app's `client.<name>.base-uri` that names another app of the run is pointed at that
app's port; any other client at the service's published port and prefix from the development
repo's platform.md (`UP: BLOCKED`, exit 3, when platform.md lacks it). A job whose spec has
`REQUIRES: <service> <commit>` lines (job.json `requires`) needs that service's container to
run an image labeled org.opencontainers.image.revision with the commit (`dev-rebuild <service>`
in the development repo); else `up` stops with PREFLIGHT: BLOCKED (exit 3). The report is
<root job>/round-<N>/verify-attempt-<k>.md; `gc` also reports service containers that run an
image older than their base branch (STALE lines; it never touches them). Services next to this repo whose application.yaml calls a changed service
(`client: <service>:`) also run, from origin/<their base branch>, so the check sees
whether the change breaks a caller.

Parallel sessions: every running app holds a lease in ~/.cache/software-factory/run (pid,
port, database), taken under one lock. Ports come from `verify.ports` (51000-51999) and
are passed as `--server.port`, never written into code; a port in use or leased is skipped.
All jobs share one infrastructure (Postgres, Keycloak, LocalStack of the development repo,
ports from its .env); each job gets its own database `sfv_<service>_<job>`. The factory never
kills a process it didn't start: a foreign process on an infra port is reported (exit 3).
If the factory started the infra itself, the last `down` stops it again; infra the user
started (dev-up) stays up. Exit 3 means the environment is missing (docker, the dev repo).
"""

import fcntl
import json
import os
import re
import signal
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from contextlib import contextmanager
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
FACTORY = REPO / "factory"
CONFIG = json.loads((FACTORY / "config.json").read_text())
VCFG = CONFIG.get("verify", {})
CLIENT = VCFG.get("client_id", "factory-app")
REALM = VCFG.get("realm", "factory")
USERS = ("admin", "manager", "user", "basic")
PG = VCFG.get("postgres", {"user": "postgres", "password": "postgres"})
PORTS = VCFG.get("ports", [51000, 51999])
MAX_MINUTES = VCFG.get("max_minutes", 45)
INFRA = VCFG.get("infra", ["db", "auth", "aws"])
RUN = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "software-factory" / "run"
def norm(name):
    return re.sub(r"[^a-z0-9]", "_", name.lower())


SERVICE = norm(REPO.name)


def die(msg, code=1):
    print(f"verify: {msg}", file=sys.stderr)
    sys.exit(code)


@contextmanager
def locked():
    RUN.mkdir(parents=True, exist_ok=True)
    with open(RUN / ".lock", "w") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        yield


def job(job_id):
    path = FACTORY / "jobs" / job_id / "job.json"
    if not path.exists():
        die(f"no job {job_id}")
    j = json.loads(path.read_text())
    return j, FACTORY / "jobs" / job_id / f"round-{j['round']}"


def dev_dir():
    if VCFG.get("dev_dir"):
        return Path(os.path.expanduser(VCFG["dev_dir"]))
    env = {}
    cfg = Path.home() / ".config/software-factory/config.env"
    if cfg.exists():
        for line in cfg.read_text().splitlines():
            if "=" in line and not line.startswith("#"):
                k, v = line.split("=", 1)
                env[k] = v
    # Projects always live side by side: <projects>/<service> and <projects>/<development>.
    projects = Path(env["PROJECTS_DIR"]).expanduser() if env.get("PROJECTS_DIR") else REPO.parent
    return projects / env.get("DEV_REPO", "development")


def dev_env(key, default):
    path = dev_dir() / ".env"
    if path.exists():
        for line in path.read_text().splitlines():
            if line.startswith(f"{key}="):
                return line.split("=", 1)[1].strip()
    return default


def keycloak():
    return f"http://localhost:{dev_env('AUTH_PORT', '8080')}/realms/{REALM}"


COMPOSE_FILES = ("docker-compose.yml", "docker-compose.override.yml", "docker-compose.services.yml")


def compose(*args, check=True):
    """docker compose in the development repo with all its files: never a subset, which would
    recreate db and auth without their host ports (the override) or miss the services."""
    d = dev_dir()
    files = [a for f in COMPOSE_FILES if (d / f).exists() for a in ("-f", f)]
    res = subprocess.run(["docker", "compose", *files, *args], cwd=d, capture_output=True, text=True)
    if check and res.returncode != 0:
        die(f"docker compose {' '.join(args)} failed: {(res.stderr or res.stdout).strip()[-800:]}")
    return res


def db_name(service, job_id):
    return f"sfv_{norm(service)}_{norm(job_id)}"[:63]


def psql(sql, check=True):
    return compose("exec", "-T", "db", "psql", "-U", PG["user"], "-v", "ON_ERROR_STOP=1", "-c", sql, check=check)


def port_busy(port):
    with socket.socket() as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            s.bind(("0.0.0.0", port))
            return False
        except OSError:
            return True


# --- the development stack's containers and the platform registry ---------------------

REVISION = "org.opencontainers.image.revision"


def platform():
    """{service: (port, path)} from the development repo's platform.md (Service | … | Port | Base URI)."""
    path = dev_dir() / "platform.md"
    out = {}
    if not path.exists():
        return out
    for line in path.read_text().splitlines():
        cells = [c.strip(" `") for c in line.strip().strip("|").split("|")]
        if len(cells) >= 4 and cells[2].isdigit() and cells[0] and cells[0] != "Service":
            out[cells[0]] = (int(cells[2]), urllib.parse.urlparse(cells[3]).path or "/")
    return out


def container_revision(service):
    """(running, git sha the container's image was built from or ''): the image label
    dev-rebuild and the skeleton Dockerfile set."""
    cid = compose("ps", "-q", "--status", "running", service, check=False).stdout.split()
    if not cid:
        return False, ""
    r = subprocess.run(["docker", "inspect", "-f", f'{{{{index .Config.Labels "{REVISION}"}}}}', cid[0]],
                       capture_output=True, text=True)
    rev = r.stdout.strip()
    return True, "" if rev in ("", "<no value>") else rev


def has_commit(repo, sha):
    git = lambda *a: subprocess.run(["git", "-C", str(repo), *a], capture_output=True, text=True)
    if git("cat-file", "-e", f"{sha}^{{commit}}").returncode != 0:
        git("fetch", "-q", "origin")
    return git("cat-file", "-e", f"{sha}^{{commit}}").returncode == 0


def requires_problems(members):
    """What the task's specs require of services that run in docker (job.json `requires`, from
    spec.md `REQUIRES:` lines) and the running containers don't have: [(needs, reason)]."""
    changed = {m["service"] for m in members}
    out = []
    for m in members:
        for req in json.loads(Path(m["jobjson"]).read_text()).get("requires") or []:
            svc, sha = req["service"], req["commit"]
            if svc in changed:  # it runs from its job branch in this check
                continue
            need = f"{svc} >= {sha[:7]}" + (f" ({req['note']})" if req.get("note") else "")
            repo = REPO.parent / svc
            running, rev = container_revision(svc)
            if not running:
                out.append((need, f"{svc} isn't running in the development stack → dev-rebuild {svc}"))
            elif not rev:
                out.append((need, f"{svc}'s image has no {REVISION} label (built without dev-rebuild), "
                                  f"can't tell if it has {sha[:7]} → dev-rebuild {svc}"))
            elif not (repo / ".git").exists() or not has_commit(repo, sha) or not has_commit(repo, rev):
                out.append((need, f"can't compare {svc} {rev[:7]} with {sha[:7]}: no clone at {repo} "
                                  "or the commits are unknown there"))
            elif subprocess.run(["git", "-C", str(repo), "merge-base", "--is-ancestor", sha, rev]).returncode:
                out.append((need, f"{svc} runs {rev[:7]}, needs {sha[:7]} → dev-rebuild {svc}"))
    return out


def stale_containers():
    """Service containers whose image isn't built from their repo's origin/<base> HEAD."""
    d = dev_dir()
    if not (d / "docker-compose.services.yml").exists():
        return []
    out = []
    for svc in re.findall(r"^  ([a-z0-9][a-z0-9-]*):\s*$", (d / "docker-compose.services.yml").read_text(), re.M):
        running, rev = container_revision(svc)
        repo = REPO.parent / svc
        if not running or not (repo / ".git").exists():
            continue
        ref = base_ref(repo)
        head = subprocess.run(["git", "-C", str(repo), "rev-parse", ref], capture_output=True, text=True).stdout.strip()
        if not rev:
            out.append(f"{svc}: image has no revision label (built without dev-rebuild) → dev-rebuild {svc}")
        elif head and has_commit(repo, rev) and subprocess.run(
                ["git", "-C", str(repo), "merge-base", "--is-ancestor", head, rev]).returncode:
            out.append(f"{svc}: container runs {rev[:7]}, {ref} is {head[:7]} → dev-rebuild {svc}")
    return out


# --- leases ---------------------------------------------------------------------------

def lease_path(service, job_id):
    return RUN / f"{norm(service)}--{job_id}.json"


def leases():
    out = []
    for p in sorted(RUN.glob("*--*.json")):
        try:
            out.append((p, json.loads(p.read_text())))
        except (OSError, ValueError):
            p.unlink(missing_ok=True)
    return out


def alive(lease):
    """True when the lease's pid is still the java we started (pids get reused)."""
    try:
        cmd = Path(f"/proc/{lease['pid']}/cmdline").read_bytes().decode(errors="replace")
    except OSError:
        return False
    return lease["jar"] in cmd


def pick_port(also=()):
    taken = {l["port"] for _, l in leases()} | set(also)
    for port in range(PORTS[0], PORTS[1] + 1):
        if port not in taken and not port_busy(port):
            return port
    die(f"no free port in {PORTS[0]}-{PORTS[1]}")


def stop_app(lease):
    if alive(lease):
        try:
            os.killpg(lease["pid"], signal.SIGTERM)
        except OSError:
            pass
        for _ in range(30):
            if not alive(lease):
                break
            time.sleep(0.5)
        else:
            try:
                os.killpg(lease["pid"], signal.SIGKILL)
            except OSError:
                pass


def release(path, lease):
    """Stop the app, drop its database, forget the lease. Caller holds the lock."""
    stop_app(lease)
    if lease.get("db") and infra_running():
        psql(f'DROP DATABASE IF EXISTS "{lease["db"]}" WITH (FORCE)', check=False)
    if lease.get("checkout"):  # a caller booted from its base branch: drop the temporary worktree
        subprocess.run(["git", "-C", lease["repo"], "worktree", "remove", "--force", lease["checkout"]],
                       capture_output=True)
    path.unlink(missing_ok=True)


def infra_running():
    if not (dev_dir() / "docker-compose.yml").exists():
        return False
    r = compose("ps", "--status", "running", "--services", check=False)
    return set(INFRA) <= set(r.stdout.split())


def infra_problems():
    """Why the shared infra can't start now: [] when it runs or can be started."""
    if not (dev_dir() / "docker-compose.yml").exists():
        return [f"no development repo at {dev_dir()} (docker-compose.yml missing)"]
    if subprocess.run(["docker", "info"], capture_output=True).returncode != 0:
        return ["docker isn't running, or this user can't reach it"]
    if infra_running():
        return []
    ports = {"DB_PORT": ("5432", "db"), "AUTH_PORT": ("8080", "auth"), "AWS_PORT": ("4566", "aws")}
    running = set(compose("ps", "--status", "running", "--services", check=False).stdout.split())
    problems = []
    for key, (default, service) in ports.items():
        port = int(dev_env(key, default))
        if service in INFRA and service not in running and port_busy(port):
            problems.append(f"port {port} ({service}) is used by another program (another stack, an ssh "
                            f"tunnel?). Stop it, or set {key} to a free port in {dev_dir() / '.env'}; "
                            "the factory never kills it")
    return problems


def preflight(job_id=None):
    """Can a local check run now? Exit 0 with PREFLIGHT: OK, else exit 3 with the reasons.
    With a job: also every service its task's specs REQUIRE runs a new enough image."""
    problems = infra_problems()
    needs = []
    if job_id and not problems:
        unmet = requires_problems(task(job_id)[2])
        needs = [n for n, _ in unmet]
        problems = [r for _, r in unmet]
    if problems:
        print("PREFLIGHT: BLOCKED " + problems[0])
        for p in problems:
            print(f"- {p}")
        for n in needs:
            print(f"NEEDS: {n}")
        sys.exit(3)
    print("PREFLIGHT: OK")


def infra_up():
    """Start the shared infra if needed; remember when the factory started it."""
    problems = infra_problems()
    if problems:
        die("; ".join(problems), 3)
    if infra_running():
        return
    compose("up", "-d", "--wait", *INFRA)
    (RUN / "infra-started-by-factory").write_text(str(dev_dir()))
    realm = dev_dir() / "scripts" / "realm.py"
    if realm.exists():  # the realm json is the truth; Keycloak imported it only once
        subprocess.run([sys.executable, str(realm), "apply"], capture_output=True)


def infra_maybe_down():
    """The last lease is gone and the factory started the infra: stop it (data kept)."""
    marker = RUN / "infra-started-by-factory"
    if marker.exists() and not leases():
        compose("stop", *INFRA, check=False)
        marker.unlink(missing_ok=True)
        print("verify: no job runs any more; stopped the infra the factory had started")


def stale(lease):
    if not alive(lease) or time.time() - lease["started"] > MAX_MINUTES * 60:
        return True
    jf = Path(lease.get("owner") or "/nonexistent")
    try:
        return json.loads(jf.read_text())["stage"] != "verify"
    except (OSError, ValueError, KeyError):
        return True


def gc(quiet=False, infra=True):
    with locked():
        gone = [(p, l) for p, l in leases() if stale(l)]
        for p, l in gone:
            release(p, l)
        if gone or not quiet:
            print(f"verify: cleaned {len(gone)} stale app(s)")
        if not quiet and infra_running():
            for line in stale_containers():  # reported only: the user's containers, never touched
                print(f"STALE: {line}")
        if infra:
            infra_maybe_down()


# --- commands -------------------------------------------------------------------------

def sync_permissions(wt):
    realm = dev_dir() / "scripts" / "realm.py"
    if (wt / "permissions.txt").exists() and realm.exists():
        r = subprocess.run([sys.executable, str(realm), "sync", str(wt)], capture_output=True, text=True)
        if r.returncode != 0:
            die("realm sync failed: " + (r.stderr or r.stdout).strip()[-600:])
        print("PERMISSIONS: " + r.stdout.strip().splitlines()[0])


def task(job_id):
    """(task folder, task id, members): members are dicts service/repo/job/worktree/round dir."""
    j, _ = job(job_id)
    tdir = Path(j["task"]) if j.get("task") else FACTORY / "jobs" / job_id
    tf = tdir / "task.json"
    rows = json.loads(tf.read_text())["members"] if tf.exists() else [
        {"service": REPO.name, "repo": str(REPO), "job": job_id}]
    members = []
    for m in rows:
        jf = Path(m["repo"]) / "factory/jobs" / m["job"] / "job.json"
        mj = json.loads(jf.read_text())
        members.append({**m, "jobjson": str(jf), "stage": mj["stage"], "worktree": Path(mj["worktree"]),
                        "logdir": jf.parent / f"round-{mj['round']}"})
    return tdir, f"{tdir.parents[2].name}/{tdir.name}", members


YAML = "src/main/resources/application.yaml"


def clients(wt, text=None):
    """`client: <name>: base-uri: "..."` entries of a service's application.yaml."""
    if text is None:
        text = (wt / YAML).read_text() if (wt / YAML).exists() else ""
    m = re.search(r"^client:\s*\n((?:[ \t]+.*\n?|\s*\n)*)", text, re.M)
    return dict(re.findall(r'^  ([a-z0-9-]+):\s*\n\s+base-uri:\s*"?([^"\s]+)"?', m.group(1), re.M)) if m else {}


def base_ref(repo):
    """origin/<base> of a sibling repo, freshly fetched (its local checkout may be stale)."""
    git = lambda *a: subprocess.run(["git", "-C", str(repo), *a], capture_output=True, text=True)
    git("fetch", "-q", "origin")
    return git("symbolic-ref", "--short", "refs/remotes/origin/HEAD").stdout.strip() or "origin/main"


def callers(names, skip):
    """Repos next to this one whose base branch calls one of `names` and aren't in the task."""
    out = []
    for repo in sorted(REPO.parent.iterdir()):
        if repo.name in skip or not (repo / ".git").exists() or not (repo / "pom.xml").exists():
            continue
        ref = base_ref(repo)
        text = subprocess.run(["git", "-C", str(repo), "show", f"{ref}:{YAML}"], capture_output=True, text=True).stdout
        if set(clients(repo, text)) & set(names):
            out.append((repo, ref))
    return out


def checkout_base(repo, base, tid):
    """A detached worktree of origin/<base> of a caller repo, under the run folder."""
    git = lambda *a: subprocess.run(["git", "-C", str(repo), *a], capture_output=True, text=True)
    dest = RUN / "checkouts" / f"{repo.name}--{norm(tid)}"
    if dest.exists():
        git("worktree", "remove", "--force", str(dest))
    dest.parent.mkdir(parents=True, exist_ok=True)
    r = git("worktree", "add", "--detach", str(dest), base)
    return dest if r.returncode == 0 else None


def build_jar(wt):
    b = subprocess.run([str(Path(__file__).resolve().parent / "mvn"), "-o", "-q", "-B", "package", "-DskipTests"], cwd=wt, capture_output=True, text=True)
    if b.returncode != 0:
        return None, (b.stdout + b.stderr)[-1500:]
    jar = next((p for p in sorted((wt / "target").glob("*.jar")) if not p.name.endswith("original")), None)
    return jar, None if jar else "no jar in target/"


def up(job_id, extra):
    tdir, tid, members = task(job_id)
    not_ready = [f"{m['service']} ({m['stage']})" for m in members if m["stage"] != "verify"]
    if not_ready:
        die("the task is checked when every job is in verify; not yet: " + ", ".join(not_ready))
    # The report path and the commits come first: sf-verifier writes the report even when booting fails.
    # One attempt file per check in the root job's round; task-result copies it to round-<N>/verify.md.
    rd = members[-1]["logdir"]
    rd.mkdir(parents=True, exist_ok=True)
    report = rd / f"verify-attempt-{len(list(rd.glob('verify-attempt-*.md'))) + 1}.md"
    commits = {m["service"]: subprocess.run(["git", "-C", str(m["worktree"]), "rev-parse", "HEAD"],
                                            capture_output=True, text=True).stdout.strip() for m in members}
    (tdir / "verify-run.json").write_text(json.dumps({"report": str(report), "commits": commits}, indent=2))
    print(f"REPORT: {report}", flush=True)
    if subprocess.run(["docker", "info"], capture_output=True).returncode != 0:
        die("docker isn't running", 3)
    if not (dev_dir() / "docker-compose.yml").exists():
        die(f"no development repo at {dev_dir()} (software-factory new development dev)", 3)
    unmet = requires_problems(members)
    if unmet:  # the environment, not the code: the verifier reports SKIP + FAULT: environment
        print("PREFLIGHT: BLOCKED " + unmet[0][1])
        for n, r in unmet:
            print(f"- {r}\nNEEDS: {n}")
        sys.exit(3)
    registry = platform()
    early = [f"client.{n} of {m['service']} has no entry in {dev_dir() / 'platform.md'}" for m in members
             for n in clients(m["worktree"]) if n not in registry and n not in {x["service"] for x in members}]
    if early:  # before any build: a client the host can't reach would only show up as a 503
        print("UP: BLOCKED " + "; ".join(early))
        print(f"NEEDS: {early[0].split(' of ')[0]} in platform.md")
        sys.exit(3)
    gc(quiet=True, infra=False)
    down_task(tid, quiet=True)
    owner = members[-1]["jobjson"]  # the root job: callers live as long as its check
    apps = []
    for m in members:
        jar, err = build_jar(m["worktree"])
        if not jar:
            die(f"{m['service']}: mvn package failed:\n{err}")
        apps.append({"service": m["service"], "key": m["job"], "wt": m["worktree"], "jar": jar,
                     "owner": m["jobjson"], "log": m["logdir"] / f"verify-{norm(m['service'])}.log",
                     "kind": "changed", "repo": m["repo"]})
    names = [m["service"] for m in members]
    for repo, ref in callers(names, set(names) | {dev_dir().name}):
        wt = checkout_base(repo, ref, tid)
        jar, err = build_jar(wt) if wt else (None, "git worktree add failed")
        if not jar:
            print(f"CALLER: {repo.name} skipped, its base branch doesn't build: {(err or '').strip()[-200:]}")
            if wt:
                subprocess.run(["git", "-C", str(repo), "worktree", "remove", "--force", str(wt)], capture_output=True)
            continue
        apps.append({"service": repo.name, "key": "base-" + norm(tid), "wt": wt, "jar": jar, "owner": owner,
                     "log": tdir / f"verify-{norm(repo.name)}.log", "kind": "caller", "repo": str(repo),
                     "checkout": str(wt)})
    blocked = []
    for a in apps:
        for name in clients(a["wt"]):
            if name not in {x["service"] for x in apps} and name not in registry:
                blocked.append(f"client.{name} of {a['service']} has no entry in {dev_dir() / 'platform.md'}")
    if blocked:
        for a in apps:
            if a.get("checkout"):
                subprocess.run(["git", "-C", a["repo"], "worktree", "remove", "--force", a["checkout"]],
                               capture_output=True)
        print("UP: BLOCKED " + "; ".join(blocked))
        print(f"NEEDS: {blocked[0].split(' of ')[0]} in platform.md")
        sys.exit(3)
    for a in apps:  # the same service as a docker container: harmless, but say which one the check calls
        running, rev = container_revision(a["service"])
        if running:
            print(f"CONTAINER: {a['service']} also runs in docker ({rev[:7] or 'no revision label'}); "
                  "the check calls the host app below, not the container")
    with locked():
        infra_up()
        picked = []
        for a in apps:
            a["port"] = pick_port(picked)
            picked.append(a["port"])
            if a["kind"] == "changed":
                sync_permissions(a["wt"])
        ports = {a["service"]: a["port"] for a in apps}
        for a in apps:
            props = {"server.port": a["port"],
                     "spring.security.oauth2.resourceserver.jwt.jwk-set-uri": f"{keycloak()}/protocol/openid-connect/certs"}
            for name, uri in clients(a["wt"]).items():
                if name in ports:  # call the other app of this run, not its docker alias
                    props[f"client.{name}.base-uri"] = f"http://localhost:{ports[name]}{urllib.parse.urlparse(uri).path}"
                else:  # a service of the stack: its published port (the docker alias isn't reachable from the host)
                    port, path = registry[name]
                    props[f"client.{name}.base-uri"] = f"http://localhost:{port}{path}"
            a["db"] = db_name(a["service"], a["key"]) if (a["wt"] / "src/main/resources/liquibase").exists() else None
            if a["db"]:
                psql(f'DROP DATABASE IF EXISTS "{a["db"]}" WITH (FORCE)')
                psql(f'CREATE DATABASE "{a["db"]}"')
                url = f"jdbc:postgresql://localhost:{dev_env('DB_PORT', '5432')}/{a['db']}"
                for pool in ("readwrite", "readonly"):
                    props.update({f"database.{pool}.url": url, f"database.{pool}.username": PG["user"],
                                  f"database.{pool}.password": PG["password"]})
            for e in extra:  # --arg wins over what up set (a repeated property would become a list)
                svc, sep, kv = e.partition(":")
                if not sep or "=" in svc:
                    kv = e
                elif svc != a["service"]:
                    continue
                key, _, value = kv.partition("=")
                props[key] = value
            args = [f"--{k}={v}" for k, v in props.items()]
            a["log"].parent.mkdir(parents=True, exist_ok=True)
            a["proc"] = subprocess.Popen(["java", "-jar", str(a["jar"]), *args], cwd=a["wt"],
                                         stdout=a["log"].open("w"), stderr=subprocess.STDOUT, start_new_session=True)
            lease_path(a["service"], a["key"]).write_text(json.dumps({
                "pid": a["proc"].pid, "port": a["port"], "db": a["db"], "jar": str(a["jar"]), "job": a["key"],
                "owner": a["owner"], "service": a["service"], "task": tid, "started": time.time(),
                "repo": a["repo"], "checkout": a.get("checkout")}))
    for a in apps:
        health = f"http://localhost:{a['port']}/actuator/health"
        for _ in range(90):
            if a["proc"].poll() is not None:
                down_task(tid, quiet=True)
                die(f"{a['service']} exited with {a['proc'].returncode}; last lines of {a['log']}:\n"
                    + "\n".join(a["log"].read_text().splitlines()[-40:]))
            try:
                with urllib.request.urlopen(health, timeout=2) as r:
                    if json.loads(r.read()).get("status") == "UP":
                        break
            except OSError:
                pass
            time.sleep(2)
        else:
            down_task(tid, quiet=True)
            die(f"{a['service']} didn't report UP within 180s (everything stopped again); see {a['log']}")
    for a in apps:
        print(f"APP: {a['service']} {a['kind']} http://localhost:{a['port']} db {a['db'] or 'none'} log {a['log']}")
    print(f"BASE_URL: http://localhost:{ports[REPO.name]}" if REPO.name in ports else "")
    print("HEALTH: UP")


def smoke(job_id):
    """GET every parameterless endpoint of every app of the task as admin; 5xx = broken."""
    _, tid, _ = task(job_id)
    apps = [l for _, l in leases() if l.get("task") == tid and alive(l)]
    if not apps:
        die(f"nothing of the task runs; verify {job_id} up first")
    tok = token("admin", quiet=True)
    broken = 0
    for l in apps:
        base = f"http://localhost:{l['port']}"
        try:
            with urllib.request.urlopen(f"{base}/v3/api-docs", timeout=10) as r:
                doc = json.loads(r.read())
        except (OSError, ValueError):
            print(f"SMOKE: {l['service']} has no /v3/api-docs; health only")
            continue
        prefix = urllib.parse.urlparse((doc.get("servers") or [{}])[0].get("url", "")).path.rstrip("/")
        for path, ops in sorted(doc.get("paths", {}).items()):
            if "get" not in ops or "{" in path:
                continue
            req = urllib.request.Request(base + prefix + path, headers={"Authorization": f"Bearer {tok}"})
            try:
                with urllib.request.urlopen(req, timeout=20) as r:
                    code = r.status
            except urllib.error.HTTPError as e:
                code = e.code
            except OSError:
                code = 599
            broken += code >= 500
            print(f"SMOKE: {l['service']} GET {prefix + path} -> {code}{'  BROKEN' if code >= 500 else ''}")
    print(f"SMOKE: {'FAIL' if broken else 'PASS'} ({broken} broken)")


def token(user, quiet=False):
    if user not in USERS:
        die(f"user is one of {', '.join(USERS)}")
    data = urllib.parse.urlencode({"grant_type": "password", "client_id": CLIENT,
                                   "username": user, "password": user}).encode()
    try:
        with urllib.request.urlopen(f"{keycloak()}/protocol/openid-connect/token", data, timeout=10) as r:
            tok = json.loads(r.read())["access_token"]
            if quiet:
                return tok
            print(tok)
    except OSError as e:
        die(f"Keycloak refused a token for {user}: {e}")


def down_task(tid, quiet=False):
    with locked():
        for path, lease in leases():
            if lease.get("task") == tid:
                release(path, lease)
        infra_maybe_down()
    if not quiet:
        print("verify: stopped every app of the task")


def down(job_id):
    down_task(task(job_id)[1])


def publish(job_id):
    """Sync the merged permissions.txt into the realm and commit + push it in the dev repo."""
    j, _ = job(job_id)
    dev, rel = dev_dir(), "docker-mounts/keycloak/factory-realm.json"
    if not (dev / rel).exists() or not (Path(j["worktree"]) / "permissions.txt").exists():
        print("verify: no realm or permissions.txt; nothing to publish")
        return
    with locked():
        sync_permissions(Path(j["worktree"]))
        git = lambda *a: subprocess.run(["git", "-C", str(dev), *a], capture_output=True, text=True)
        if not git("status", "--porcelain", "--", rel).stdout.strip():
            print("verify: the realm already has every permission")
            return
        git("add", "--", rel)
        git("commit", "-m", f"Keycloak permissions from {REPO.name} ({job_id})", "--", rel)
        if git("remote").stdout.strip():
            if git("pull", "--rebase", "--autostash", "-q").returncode != 0:
                git("rebase", "--abort")
                print(f"verify: committed the realm in {dev}; pull failed, push it by hand")
                return
            pushed = git("push", "-q")
            if pushed.returncode != 0:
                print(f"verify: committed the realm in {dev}, push failed: {pushed.stderr.strip()[-200:]}")
                return
        print(f"verify: realm permissions committed in {dev}")


def ps():
    rows = leases()
    for _, l in rows:
        state = "running" if alive(l) else "dead"
        print(f"{l['service']:20} {l['job']:12} port {l['port']}  db {l['db'] or '-'}  {state}  "
              f"{int((time.time() - l['started']) / 60)} min")
    print(f"verify: {len(rows)} app(s); infra {'up' if infra_running() else 'down'}"
          f"{' (started by the factory)' if (RUN / 'infra-started-by-factory').exists() else ''}")


def main(argv):
    if argv == ["gc"]:
        gc()
    elif argv[:1] == ["preflight"] and len(argv) <= 2:
        preflight(argv[1] if len(argv) == 2 else None)
    elif argv == ["ps"]:
        ps()
    elif len(argv) >= 2 and argv[1] == "up":
        rest, extra = argv[2:], []
        while rest:
            if rest[0] != "--arg" or len(rest) < 2:
                die("up takes only --arg key=value pairs")
            extra.append(rest[1])
            rest = rest[2:]
        up(argv[0], extra)
    elif len(argv) in (2, 3) and argv[1] == "token":
        token(argv[2] if len(argv) == 3 else "admin")
    elif len(argv) == 2 and argv[1] == "publish":
        publish(argv[0])
    elif len(argv) == 2 and argv[1] == "down":
        down(argv[0])
    elif len(argv) == 2 and argv[1] == "smoke":
        smoke(argv[0])
    else:
        die(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
